# Copy to .env. Only EXPO_PUBLIC_* values are readable by the app; keep secrets out of them.

# URL of the IoT Sentinel server (server/ folder). For local testing use your Mac's LAN IP with the
# local dev server running (cd server && npm run dev):   http://192.168.x.x:3001
# After deploying to Vercel:                              https://<project>.vercel.app
EXPO_PUBLIC_AI_API_URL=

# Only if the server sets SENTINEL_APP_TOKEN
EXPO_PUBLIC_AI_APP_TOKEN=

# Used by the local dev server and scripts/testOpenAIKey.js only. NEVER prefix this with EXPO_PUBLIC_.
OPEN_AI_API_KEY=
